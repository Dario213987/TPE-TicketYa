		{
			"name": "11. Rechazar devolución exitosa (200)",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Estado es DENEGADA con motivoRechazo y auditoría\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.estado).to.eql(\"DENEGADA\");",
							"    pm.expect(jsonData.motivoRechazo).to.eql(\"No cumple con los términos y condiciones de devolución\");",
							"    pm.expect(jsonData.resueltaPor).to.be.a(\"number\");",
							"    pm.expect(jsonData.fechaResolucion).to.not.be.null;",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "X-User-Id",
						"value": "1"
					},
					{
						"key": "X-User-Role",
						"value": "ADMINISTRADOR"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"motivo\": \"No cumple con los términos y condiciones de devolución\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/devoluciones/1/rechazar",
					"host": [

	"item": [
		{
			"name": "1. Solicitar devolución exitosa (201)",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"pm.test(\"Estado es PENDIENTE\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.estado).to.eql(\"PENDIENTE\");",
							"    pm.expect(jsonData.ticketId).to.eql(100);",
							"    pm.expect(jsonData.clienteId).to.eql(10);",
							"    pm.expect(jsonData.id).to.be.a(\"number\");",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "X-User-Id",
						"value": "{{userId}}"
					},
					{
						"key": "X-User-Role",
						"value": "{{role}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"ticketId\": 100,\n  \"motivo\": \"No podré asistir por motivos personales\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/devoluciones",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"devoluciones"
					]
				}
			}
		},

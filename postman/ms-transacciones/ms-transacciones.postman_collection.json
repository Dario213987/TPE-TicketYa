			"item": [
				{
					"name": "Generar débito",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
									"const j = pm.response.json();",
									"pm.collectionVariables.set(\"transaccionId\", j.id);",
									"pm.test(\"tipo DEBITO\", () => pm.expect(j.tipo).to.eql(\"DEBITO\"));",
									"pm.test(\"tiene fechas\", () => { pm.expect(j.creadoEl).to.exist; pm.expect(j.actualizadoEl).to.exist; });"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-User-Id",
								"value": "{{userId}}"
							},
							{
								"key": "X-User-Role",
								"value": "{{role}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"ticketId\": {{ticketId}},\n  \"clienteId\": {{clienteId}},\n  \"monto\": 100.0\n}",

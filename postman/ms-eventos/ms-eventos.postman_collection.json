				{
					"name": "Listar ordenado por relevancia",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
									"const content = pm.response.json().content;",
									"pm.test(\"solo estados visibles\", () => content.forEach(e => pm.expect([\"PUBLICADO\",\"AGOTADO\"]).to.include(e.estado)));",
									"pm.test(\"PUBLICADO antes que AGOTADO\", () => {",
									"  const primerAgotado = content.findIndex(e => e.estado === \"AGOTADO\");",
									"  const ultimoPublicado = content.map(e => e.estado).lastIndexOf(\"PUBLICADO\");",
									"  if (primerAgotado !== -1 && ultimoPublicado !== -1) pm.expect(ultimoPublicado).to.be.below(primerAgotado);",
									"});"
								]
							}
						}

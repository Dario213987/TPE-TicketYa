					"name": "Listar eventos publicados",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
									"const j = pm.response.json();",
									"pm.test(\"trae content y page\", () => { pm.expect(j.content).to.be.an(\"array\"); pm.expect(j.page).to.exist; });",
									"pm.test(\"solo estados visibles\", () => j.content.forEach(e => pm.expect([\"PUBLICADO\",\"AGOTADO\"]).to.include(e.estado)));"
								]
							}
						}

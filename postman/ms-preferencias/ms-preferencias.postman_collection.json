              "raw": "{\n  \"tiposFavoritos\": [\"TEATRO\", \"FESTIVAL\", \"TEATRO\"],\n  \"artistasFavoritos\": [20, 20],\n  \"ciudad\": \"Rauch\"\n}",
              "options": {

        {
          "name": "Guardar de nuevo reemplaza y deduplica",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"reemplaza los valores anteriores\", () => pm.expect(j.tiposFavoritos).to.eql([\"TEATRO\", \"FESTIVAL\"]));",
                  "pm.test(\"deduplica sin perder el orden\", () => pm.expect(j.tiposFavoritos).to.have.lengthOf(2));",
                  "pm.test(\"reemplaza la ciudad\", () => pm.expect(j.ciudad).to.eql(\"Rauch\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{clienteId}}"

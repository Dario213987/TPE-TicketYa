{
  "info": {
    "_postman_id": "a7c4e2d1-58b3-4f6a-9c02-7d1e5b8f2a63",
    "name": "ms-preferencias",
    "description": "Preferencias del cliente (US-09.01). Requiere X-User-Id (numerico) y X-User-Role: CLIENTE. Las rutas se exponen a traves del gateway bajo /api/preferencias. El cliente sale del header, no del cuerpo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Preferencias",
      "item": [
        {
          "name": "Consultar sin haber cargado nada (200 vacio)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"devuelve el cliente del header\", () => pm.expect(j.clienteId).to.eql(Number(pm.collectionVariables.get(\"clienteId\"))));",
                  "pm.test(\"listas vacias, no 404\", () => { pm.expect(j.tiposFavoritos).to.eql([]); pm.expect(j.artistasFavoritos).to.eql([]); });",
                  "pm.test(\"ciudad null mientras no haya perfil\", () => pm.expect(j.ciudad).to.eql(null));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{clienteId}}"
              },
              {
                "key": "X-User-Role",
                "value": "CLIENTE"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/preferencias/mias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "preferencias",
                "mias"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Guardar preferencias",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"guarda los tipos favoritos\", () => pm.expect(j.tiposFavoritos).to.eql([\"RECITAL\"]));",
                  "pm.test(\"guarda los artistas favoritos\", () => pm.expect(j.artistasFavoritos).to.eql([15]));",
                  "pm.test(\"normaliza la ciudad\", () => pm.expect(j.ciudad).to.eql(\"Tandil\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{clienteId}}"
              },
              {
                "key": "X-User-Role",
                "value": "CLIENTE"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tiposFavoritos\": [\"RECITAL\"],\n  \"artistasFavoritos\": [15],\n  \"ciudad\": \"  Tandil  \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/preferencias/mias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "preferencias",
                "mias"
              ]
            }
          },
          "response": []
        },

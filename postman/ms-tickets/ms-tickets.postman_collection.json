                  "const j = pm.response.json();",
                  "pm.test(\"yaEstabaEnFila true\", () => pm.expect(j.yaEstabaEnFila).to.eql(true));",
                  "pm.test(\"conserva la posición anterior\", () => pm.expect(String(j.posicion)).to.eql(pm.collectionVariables.get(\"posicionFila\")));"
                ]
              }
            }
          ],
          "request": {

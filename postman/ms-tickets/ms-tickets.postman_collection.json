    {
      "name": "3. Fila virtual",
      "description": "Requiere que el evento {{eventoId}} tenga disponibilidad publicada con altaDemanda=true (lo hace la carpeta 1). Cada corrida usa un cliente nuevo ({{clienteFila}}) para que el 201 sea repetible sin borrar la clave de Redis.",
      "item": [
        {
          "name": "Entrar a la fila (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"clienteFila\", String(Math.floor(Math.random() * 1000000) + 1));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"devuelve evento y cliente\", () => { pm.expect(j.eventoId).to.eql(Number(pm.collectionVariables.get(\"eventoId\"))); pm.expect(j.clienteId).to.eql(Number(pm.collectionVariables.get(\"clienteFila\"))); });",
                  "pm.test(\"ingresa al final de la fila\", () => { pm.expect(j.posicion).to.be.at.least(1); pm.expect(j.totalEnFila).to.be.at.least(j.posicion); pm.expect(j.yaEstabaEnFila).to.eql(false); });",
                  "pm.test(\"informa el momento de ingreso\", () => pm.expect(j.ingresadoEl).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"posicionFila\", String(j.posicion));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{clienteFila}}"
              },
              {
                "key": "X-User-Role",
                "value": "CLIENTE"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/eventos/{{eventoId}}/fila",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                "eventos",
                "{{eventoId}}",
                "fila"
              ]
            }
          },
          "response": []
        },

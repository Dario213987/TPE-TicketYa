{
  "info": {
    "_postman_id": "5d3f9a2e-7c41-4b8e-9f10-2a6c1e8b3d47",
    "name": "ms-tickets",
    "description": "Gestion de disponibilidad y reservas de entradas. Requiere X-User-Id (numerico) y X-User-Role. Las rutas se exponen a traves del gateway bajo /api/tickets. Ejecutar en orden: la carpeta 1 crea la disponibilidad que usan las demas y marca el evento principal como alta demanda para la carpeta 3.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Disponibilidad",
      "item": [
        {
          "name": "Publicar disponibilidad (numerado + no numerado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 o 201\", () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "const j = pm.response.json();",
                  "pm.test(\"devuelve el eventoId\", () => pm.expect(j.eventoId).to.eql(Number(pm.collectionVariables.get(\"eventoId\"))));",
                  "pm.test(\"informa sectores procesados\", () => pm.expect(j.sectoresProcesados).to.be.a(\"number\"));",
                  "pm.test(\"informa asientos insertados/omitidos\", () => { pm.expect(j.asientosInsertados).to.be.a(\"number\"); pm.expect(j.asientosOmitidos).to.be.a(\"number\"); });",
                  "pm.test(\"altaDemanda true\", () => pm.expect(pm.response.json().altaDemanda).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{organizadorId}}"
              },
              {
                "key": "X-User-Role",
                "value": "ORGANIZADOR"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventoId\": {{eventoId}},\n  \"limiteEntradasPorCliente\": 4,\n  \"altaDemanda\": true,\n  \"sectores\": [\n    {\n      \"sectorId\": {{sectorNumeradoId}},\n      \"tipo\": \"NUMERADO\",\n      \"filas\": 2,\n      \"asientosPorFila\": 3\n    },\n    {\n      \"sectorId\": {{sectorNoNumeradoId}},\n      \"tipo\": \"NO_NUMERADO\",\n      \"capacidadMaxima\": 10\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/eventos/{{eventoId}}/disponibilidad",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                "eventos",
                "{{eventoId}}",
                "disponibilidad"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Publicar de nuevo (idempotente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [

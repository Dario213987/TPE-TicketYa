        {
          "name": "Consultar disponibilidad",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"devuelve los sectores\", () => pm.expect(j.sectores).to.be.an(\"array\").that.is.not.empty);",
                  "pm.test(\"incluye limite por cliente\", () => pm.expect(j.limiteEntradasPorCliente).to.be.a(\"number\"));",
                  "const numerado = j.sectores.find(s => s.tipoSector === \"NUMERADO\");",
                  "pm.test(\"el sector numerado informa asientos\", () => pm.expect(numerado.asientos).to.be.an(\"array\").that.is.not.empty);",
                  "pm.test(\"informa altaDemanda\", () => pm.expect(pm.response.json().altaDemanda).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/eventos/{{eventoId}}/disponibilidad",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                "eventos",
                "{{eventoId}}",
                "disponibilidad"

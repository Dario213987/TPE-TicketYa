              {
                "key": "X-User-Role",
                "value": "ORGANIZADOR"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventoId\": {{eventoSinAltaDemandaId}},\n  \"limiteEntradasPorCliente\": 4,\n  \"altaDemanda\": false,\n  \"sectores\": [\n    {\n      \"sectorId\": {{sectorNoNumeradoId}},\n      \"tipo\": \"NO_NUMERADO\",\n      \"capacidadMaxima\": 5\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },

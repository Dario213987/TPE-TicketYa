          "name": "Publicar disponibilidad sin alta demanda (otro evento)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 o 201\", () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "const j = pm.response.json();",
                  "pm.test(\"devuelve el eventoId\", () => pm.expect(j.eventoId).to.eql(Number(pm.collectionVariables.get(\"eventoSinAltaDemandaId\"))));",
                  "pm.test(\"altaDemanda false\", () => pm.expect(j.altaDemanda).to.eql(false));"
                ]
              }

{
  "info": { "name": "TicketYa - ms-usuarios", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userId", "value": "1" },
    { "key": "rol", "value": "ADMINISTRADOR" },
    { "key": "usuarioId", "value": "1" },
    { "key": "token", "value": "" },
    { "key": "loginEmail", "value": "admin@ticketya.com" },
    { "key": "loginPassword", "value": "claveSegura1" }
  ],
  "event": [{ "listen": "prerequest", "script": { "exec": [
    "if (!pm.request.url.getPath().startsWith('/api/auth/')) {",
    "  pm.request.headers.upsert({key: 'X-User-Id', value: pm.collectionVariables.get('userId')});",
    "  pm.request.headers.upsert({key: 'X-User-Role', value: pm.collectionVariables.get('rol')});",
    "}"
  ] } }],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registro público",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 y rol CLIENTE', function () {",
            "  pm.response.to.have.status(201);",
            "  pm.expect(pm.response.json().roles).to.eql(['CLIENTE']);",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"cliente@mail.com\",\n  \"nombre\": \"Cliente\",\n  \"password\": \"secreta123\"\n}" },
            "url": "{{baseUrl}}/api/auth/registro"
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200) {",
            "  pm.collectionVariables.set('token', pm.response.json().accessToken);",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Crear usuario",
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('usuarioId', pm.response.json().id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"ana@mail.com\",\n  \"nombre\": \"Ana\",\n  \"password\": \"secreta123\",\n  \"roles\": [\"ORGANIZADOR\"]\n}" },
            "url": "{{baseUrl}}/api/usuarios"
          }
        },
        { "name": "Obtener por id", "request": { "method": "GET", "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}" } },
        { "name": "Listar", "request": { "method": "GET", "url": "{{baseUrl}}/api/usuarios?size=10&sort=email,asc" } },
        {
          "name": "Cambiar roles",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"roles\": [\"CLIENTE\", \"ORGANIZADOR\"]\n}" },
            "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}/roles"
          }
        }
      ]
    }
  ]
}
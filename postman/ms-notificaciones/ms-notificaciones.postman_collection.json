{
  "info": {
    "name": "ms-notificaciones",
    "description": "Colección de ms-notificaciones. Incluye el runbook E2E de PUBLICACION_ARTISTA: preferencias por ciudad + artista favorito, RabbitMQ y MailHog.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "internalBaseUrl", "value": "http://localhost:8081" },
    { "key": "rabbitmqUrl", "value": "http://localhost:15672" },
    { "key": "rabbitmqUser", "value": "ticketya" },
    { "key": "rabbitmqPassword", "value": "123" },
    { "key": "mailhogUrl", "value": "http://localhost:8025" },
    { "key": "clienteId", "value": "20" },
    { "key": "artistaId", "value": "15" },
    { "key": "artistaNombre", "value": "La Renga" },
    { "key": "eventoId", "value": "10" },
    { "key": "ciudad", "value": "Tandil" },
    { "key": "mensajeId", "value": "MSE-PUBLICACION_ARTISTA-10" }
  ],
  "item": [
    {
      "name": "E2E PUBLICACION_ARTISTA",
      "item": [
        {
          "name": "0. Limpiar MailHog",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{mailhogUrl}}/api/v1/messages",
              "host": ["{{mailhogUrl}}"],
              "path": ["api", "v1", "messages"]
            }
          }
        },
        {
          "name": "1. Ver evento con participantes y ciudad",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"ciudad del lugar\", () => pm.expect(j.lugar.ciudad).to.eql(pm.collectionVariables.get(\"ciudad\")));",
                  "pm.test(\"artista participante\", () => pm.expect(j.participantes.map(p => String(p.id))).to.include(String(pm.collectionVariables.get(\"artistaId\"))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/eventos/{{eventoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "eventos", "{{eventoId}}"]
            }
          }
        },
        {
          "name": "2. Cargar preferencias del cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"cliente correcto\", () => pm.expect(String(j.clienteId)).to.eql(String(pm.collectionVariables.get(\"clienteId\"))));",
                  "pm.test(\"artista favorito guardado\", () => pm.expect(j.artistasFavoritos.map(String)).to.include(String(pm.collectionVariables.get(\"artistaId\"))));",
                  "pm.test(\"ciudad guardada\", () => pm.expect(j.ciudad).to.eql(pm.collectionVariables.get(\"ciudad\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{clienteId}}" },
              { "key": "X-User-Role", "value": "CLIENTE" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ciudad\": \"{{ciudad}}\",\n  \"tiposFavoritos\": [],\n  \"artistasFavoritos\": [{{artistaId}}]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/preferencias/mias",
              "host": ["{{baseUrl}}"],
              "path": ["api", "preferencias", "mias"]
            }
          }
        },
        {
          "name": "3. Publicar aviso en la cola enviar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"mensaje enrutado\", () => pm.expect(pm.response.json().routed).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{rabbitmqUser}}", "type": "string" },
                { "key": "password", "value": "{{rabbitmqPassword}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"properties\": {\n    \"delivery_mode\": 2,\n    \"content_type\": \"application/json\",\n    \"headers\": {\n      \"__TypeId__\": \"org.tudai.ticketya.contract.notificaciones.messaging.NotificacionEntranteDTO\"\n    }\n  },\n  \"routing_key\": \"enviar\",\n  \"payload\": \"{\\\"mensajeId\\\":\\\"{{mensajeId}}\\\",\\\"motivo\\\":\\\"PUBLICACION_ARTISTA\\\",\\\"eventoId\\\":{{eventoId}},\\\"destinatarioId\\\":null}\",\n  \"payload_encoding\": \"string\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{rabbitmqUrl}}/api/exchanges/%2F/amq.default/publish",
              "host": ["{{rabbitmqUrl}}"],
              "path": ["api", "exchanges", "%2F", "amq.default", "publish"]
            }
          }
        },
        {
          "name": "4. Verificar correo en MailHog",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"llego un correo\", () => pm.expect(j.total).to.eql(1));",
                  "const m = j.items[0];",
                  "const body = m.Content.Body;",
                  "const subject = m.Content.Headers.Subject;",
                  "pm.test(\"asunto del motivo\", () => pm.expect(subject).to.include(\"PUBLICACION_ARTISTA\"));",
                  "pm.test(\"participante en el cuerpo\", () => pm.expect(body).to.include(pm.collectionVariables.get(\"artistaNombre\")));",
                  "pm.test(\"ciudad en el cuerpo\", () => pm.expect(body).to.include(pm.collectionVariables.get(\"ciudad\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{mailhogUrl}}/api/v2/messages",
              "host": ["{{mailhogUrl}}"],
              "path": ["api", "v2", "messages"]
            }
          }
        },
        {
          "name": "5. Republicar mismo mensaje (idempotencia)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"mensaje enrutado\", () => pm.expect(pm.response.json().routed).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{rabbitmqUser}}", "type": "string" },
                { "key": "password", "value": "{{rabbitmqPassword}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"properties\": {\n    \"delivery_mode\": 2,\n    \"content_type\": \"application/json\",\n    \"headers\": {\n      \"__TypeId__\": \"org.tudai.ticketya.contract.notificaciones.messaging.NotificacionEntranteDTO\"\n    }\n  },\n  \"routing_key\": \"enviar\",\n  \"payload\": \"{\\\"mensajeId\\\":\\\"{{mensajeId}}\\\",\\\"motivo\\\":\\\"PUBLICACION_ARTISTA\\\",\\\"eventoId\\\":{{eventoId}},\\\"destinatarioId\\\":null}\",\n  \"payload_encoding\": \"string\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{rabbitmqUrl}}/api/exchanges/%2F/amq.default/publish",
              "host": ["{{rabbitmqUrl}}"],
              "path": ["api", "exchanges", "%2F", "amq.default", "publish"]
            }
          }
        },
        {
          "name": "6. Verificar que no hay segundo correo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"sigue habiendo un solo correo\", () => pm.expect(pm.response.json().total).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{mailhogUrl}}/api/v2/messages",
              "host": ["{{mailhogUrl}}"],
              "path": ["api", "v2", "messages"]
            }
          }
        }
      ]
    }
  ]
}

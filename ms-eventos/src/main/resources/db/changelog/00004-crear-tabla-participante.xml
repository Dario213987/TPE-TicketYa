<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="00004-crear-tabla-participante" author="maxi">
        <createTable tableName="participantes">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nombre" type="varchar(255)"/>
        </createTable>

        <createTable tableName="evento_participante">
            <column name="evento_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="participante_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="evento_participante"
                       columnNames="evento_id, participante_id"
                       constraintName="pk_evento_participante"/>

        <addForeignKeyConstraint baseTableName="evento_participante"
                                 baseColumnNames="evento_id"
                                 constraintName="fk_evento_participante_evento"
                                 referencedTableName="eventos"
                                 referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="evento_participante"
                                 baseColumnNames="participante_id"
                                 constraintName="fk_evento_participante_participante"
                                 referencedTableName="participantes"
                                 referencedColumnNames="id"/>

        <createIndex tableName="evento_participante" indexName="idx_evento_participante_participante">
            <column name="participante_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>

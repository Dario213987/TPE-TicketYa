<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="00001-crear-tabla-asiento" author="maxi">

        <createTable tableName="asiento">
            <column name="fila"></column>
            <column name="numero"></column>
        </createTable>
        <createIndex tableName="asiento" indexName="idx_fila_numero">
            <column name="fila"></column>
            <column name="asiento"></column>
        </createIndex>
    </changeSet>
</databaseChangeLog>
<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="00003-crear-tablas-ventas" author="manuel">
        <createTable tableName="ventas">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_ventas" nullable="false"/>
            </column>
            <column name="reserva_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="evento_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="total" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="medio_pago" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="creado_el" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="ventas" columnNames="reserva_id" constraintName="uq_ventas_reserva"/>

        <addForeignKeyConstraint baseTableName="ventas" baseColumnNames="reserva_id"
                                 constraintName="fk_ventas_reserva"
                                 referencedTableName="reservas" referencedColumnNames="id"/>

        <createIndex tableName="ventas" indexName="idx_ventas_evento_cliente">
            <column name="evento_id"/>
            <column name="cliente_id"/>
        </createIndex>

        <createTable tableName="venta_items">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_venta_items" nullable="false"/>
            </column>
            <column name="venta_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="ticket_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="sector_id_externo" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="fila" type="INTEGER"/>
            <column name="numero" type="INTEGER"/>
            <column name="precio" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="transaccion_id" type="BIGINT"/>
        </createTable>

        <addUniqueConstraint tableName="venta_items" columnNames="ticket_id" constraintName="uq_venta_items_ticket"/>

        <addForeignKeyConstraint baseTableName="venta_items" baseColumnNames="venta_id"
                                 constraintName="fk_venta_items_venta"
                                 referencedTableName="ventas" referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="venta_items" baseColumnNames="ticket_id"
                                 constraintName="fk_venta_items_ticket"
                                 referencedTableName="tickets" referencedColumnNames="id"/>

        <addColumn tableName="tickets">
            <column name="venta_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint baseTableName="tickets" baseColumnNames="venta_id"
                                 constraintName="fk_tickets_venta"
                                 referencedTableName="ventas" referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>

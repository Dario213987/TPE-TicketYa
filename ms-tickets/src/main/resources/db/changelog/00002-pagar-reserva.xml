<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="00002-pagar-reserva" author="manuel">
        <addColumn tableName="disponibilidad_eventos">
            <column name="organizador_id" type="BIGINT"/>
        </addColumn>

        <addColumn tableName="disponibilidad_sectores">
            <column name="precio" type="DOUBLE PRECISION"/>
        </addColumn>

        <addColumn tableName="reservas">
            <column name="idempotency_key" type="VARCHAR(100)"/>
            <column name="medio_pago" type="VARCHAR(30)"/>
            <column name="estado_pago" type="VARCHAR(20)"/>
            <column name="motivo_rechazo" type="VARCHAR(255)"/>
            <column name="pagado_el" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>

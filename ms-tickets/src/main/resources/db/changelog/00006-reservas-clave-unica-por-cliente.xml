<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- TKY-88: una Idempotency-Key identifica un solo pago por cliente. -->
    <changeSet id="00006-reservas-clave-unica-por-cliente" author="manuel">
        <addUniqueConstraint tableName="reservas"
                             columnNames="cliente_id, idempotency_key"
                             constraintName="uk_reservas_cliente_idempotency_key"/>
    </changeSet>
</databaseChangeLog>
